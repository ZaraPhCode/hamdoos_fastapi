# One-off data migration image: SQL Server -> PostgreSQL
# Keep this separate from the prod app image to avoid bloating
# production with ODBC drivers.
#
# Usage (see docker-compose.migrate.yml and deploy/migrate.sh):
#   docker compose -f docker-compose.migrate.yml build migrator
#   docker compose -f docker-compose.migrate.yml run --rm migrator --plan

FROM python:3.12-slim-bookworm

WORKDIR /app

# IR firewall blocks deb.debian.org — switch to Arvan mirror before any apt-get
# Original URIs: http://deb.debian.org/debian and http://deb.debian.org/debian-security
# Arvan hosts them as https://mirror.arvancloud.ir/debian and .../debian-security
RUN sed -i 's|http://deb.debian.org|https://mirror.arvancloud.ir|g' /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|https://deb.debian.org|https://mirror.arvancloud.ir|g' /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    cat /etc/apt/sources.list.d/debian.sources 2>/dev/null || cat /etc/apt/sources.list 2>/dev/null || true

# System deps:
#  - gcc/g++ + unixodbc-dev for building pyodbc
#  - libpq-dev for psycopg2
#  - tdsodbc/freetds for SQL Server (FreeTDS avoids packages.microsoft.com which is blocked in IR)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev unixodbc-dev tdsodbc freetds-bin freetds-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && odbcinst -q -d 2>&1 | grep -q FreeTDS || echo "[FreeTDS]\nDriver=/usr/lib/x86_64-linux-gnu/odbc/libtdsodbc.so" >> /etc/odbcinst.ini \
    && cat /etc/odbcinst.ini

# Reuse prod requirements + add only migration extras (keeps prod requirements.txt lean)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "pyodbc==5.1.0"

# Copy project (needed for app/models for alembic + migrate script itself)
COPY . .

# Default: show help. Override with --plan, --tables, --set-admin-pass, etc.
ENTRYPOINT ["python", "migrate_sqlserver_to_postgres.py"]
CMD ["--help"]
