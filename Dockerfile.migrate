# One-off data migration image: SQL Server -> PostgreSQL
# Keep this separate from the prod app image to avoid bloating
# production with ODBC drivers.
#
# Usage (see docker-compose.migrate.yml and deploy/migrate.sh):
#   docker compose -f docker-compose.migrate.yml build migrator
#   docker compose -f docker-compose.migrate.yml run --rm migrator --plan

FROM python:3.12-slim-bookworm

WORKDIR /app

# IR firewall blocks deb.debian.org — switch to AminIDC mirror (Arvan 404 on /debian)
# Docker registry mirror (Chabokan) does NOT affect apt; this is for Debian packages.
RUN echo "Types: deb\nURIs: http://mirror.aminidc.com/debian\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg" > /etc/apt/sources.list.d/debian.sources && \
    echo "Types: deb\nURIs: http://mirror.aminidc.com/debian-security\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg" > /etc/apt/sources.list.d/debian-security.sources && \
    echo "Types: deb\nURIs: http://mirror.aminidc.com/debian\nSuites: bookworm-backports\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg" > /etc/apt/sources.list.d/debian-backports.sources 2>/dev/null || true && \
    cat /etc/apt/sources.list.d/debian.sources && cat /etc/apt/sources.list.d/debian-security.sources

# System deps:
#  - gcc/g++ + unixodbc-dev for building pyodbc
#  - libpq-dev for psycopg2
#  - tdsodbc/freetds for SQL Server (FreeTDS avoids packages.microsoft.com which is blocked in IR)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev unixodbc unixodbc-dev tdsodbc freetds-bin freetds-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ldconfig \
    && odbcinst -q -d 2>&1 | grep -q FreeTDS || echo "[FreeTDS]\nDriver=/usr/lib/x86_64-linux-gnu/odbc/libtdsodbc.so" >> /etc/odbcinst.ini \
    && cat /etc/odbcinst.ini \
    && ls -l /usr/lib/x86_64-linux-gnu/libodbc* /usr/lib/x86_64-linux-gnu/odbc/* 2>&1 | head -n 20

# Reuse prod requirements + add only migration extras (keeps prod requirements.txt lean)
# pip pypi is also filtered in IR — use Runflare mirror
COPY requirements.txt .
RUN pip install --no-cache-dir --index-url https://mirror-pypi.runflare.com/simple --trusted-host mirror-pypi.runflare.com -r requirements.txt \
    && pip install --no-cache-dir --index-url https://mirror-pypi.runflare.com/simple --trusted-host mirror-pypi.runflare.com "pyodbc==5.1.0"

# Copy project (needed for app/models for alembic + migrate script itself)
COPY . .

# Default: show help. Override with --plan, --tables, --set-admin-pass, etc.
ENTRYPOINT ["python", "migrate_sqlserver_to_postgres.py"]
CMD ["--help"]
