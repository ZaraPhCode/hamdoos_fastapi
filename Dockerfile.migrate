# One-off data migration image: SQL Server -> PostgreSQL
# Keep this separate from the prod app image to avoid bloating
# production with ODBC drivers.
#
# Usage (see docker-compose.migrate.yml and deploy/migrate.sh):
#   docker compose -f docker-compose.migrate.yml build migrator
#   docker compose -f docker-compose.migrate.yml run --rm migrator --plan

FROM python:3.12-slim-bookworm

WORKDIR /app

# Debian mirrors — IR firewall blocks deb.debian.org, so use the AminIDC mirror.
# IMPORTANT: AminIDC does NOT mirror a separate debian-security tree, so
# `debian-security bookworm-security` returns 404 and silently breaks apt.
# Everything we install lives in main, so only bookworm + bookworm-updates are
# configured (fine for a one-off migration image).
#
# System deps:
#  - gcc/g++ + unixodbc-dev for building pyodbc
#  - libpq-dev for psycopg2
#  - tdsodbc/freetds for SQL Server (FreeTDS avoids packages.microsoft.com which is blocked in IR)
RUN set -eux; \
    printf 'deb http://mirror.aminidc.com/debian bookworm main\ndeb http://mirror.aminidc.com/debian bookworm-updates main\n' \
      > /etc/apt/sources.list.d/asha.list; \
    rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/debian-security.sources; \
    cat /etc/apt/sources.list.d/asha.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev unixodbc unixodbc-dev tdsodbc freetds-bin freetds-dev ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig; \
    printf '[FreeTDS]\nDriver=/usr/lib/x86_64-linux-gnu/odbc/libtdsodbc.so\n' >> /etc/odbcinst.ini; \
    cat /etc/odbcinst.ini; \
    odbcinst -q -d; \
    ls -l /usr/lib/x86_64-linux-gnu/libodbc* /usr/lib/x86_64-linux-gnu/odbc/*

# Reuse prod requirements (pyodbc is already in requirements.txt).
# PyPI is filtered from this VPS: pypi.org / Tsinghua / Aliyun all fail with
# `Network is unreachable`. The VPS CAN reach mirror.chabokan.net (it is the
# Docker registry mirror Docker already uses) and Chabokan also proxies PyPI,
# so try it first; pypi.org and CN mirrors are fallbacks.
#   Override with: --build-arg PIP_INDEX=https://<working-index>/simple
# --retries 0 + --timeout fail unreachable hosts in seconds instead of letting
# pip retry each of the 59 packages for hours.
ARG PIP_INDEX=""
COPY requirements.txt .
RUN set -ux; \
    _ok=0; \
    if [ -n "$PIP_INDEX" ]; then \
        echo "==> pip using configured index: $PIP_INDEX"; \
        if pip install --no-cache-dir --index-url "$PIP_INDEX" --retries 0 --timeout 20 -r requirements.txt \
            && pip install --no-cache-dir --index-url "$PIP_INDEX" --retries 0 --timeout 20 "pyodbc==5.1.0"; then \
            _ok=1; \
        fi; \
    else \
        for idx in \
                "https://mirror.chabokan.net/pypi/simple" \
                "https://mirror.chabokan.net/repository/pypi/simple" \
                "https://pypi.org/simple" \
                "https://pypi.tuna.tsinghua.edu.cn/simple" \
                "https://mirrors.aliyun.com/pypi/simple"; do \
            echo "==> pip trying index: $idx"; \
            if pip install --no-cache-dir --index-url "$idx" --retries 0 --timeout 20 -r requirements.txt \
                && pip install --no-cache-dir --index-url "$idx" --retries 0 --timeout 20 "pyodbc==5.1.0"; then \
                _ok=1; \
                break; \
            fi; \
        done; \
    fi; \
    test "$_ok" -eq 1 || { \
        echo 'ERROR: no reachable PyPI index from this machine.' >&2; \
        echo '  Find a working index, then rebuild with it:' >&2; \
        echo '    docker compose -f docker-compose.migrate.yml build --build-arg PIP_INDEX=https://<index>/simple migrator' >&2; \
        echo '  OR build on an internet-connected machine and transfer the image:' >&2; \
        echo '    docker save asha-shop-fastapi-migrator | gzip > mig.tar.gz   # on the builder' >&2; \
        echo '    scp mig.tar.gz <vps>: && docker load < mig.tar.gz            # on the VPS' >&2; \
        exit 1; }; \
    python -c "import pyodbc, psycopg2, fastapi, sqlalchemy, alembic; print('python deps OK; pyodbc', pyodbc.version)"

# Copy project (needed for app/models for alembic + migrate script itself)
COPY . .

# Default: show help. Override with --plan, --tables, --set-admin-pass, etc.
ENTRYPOINT ["python", "migrate_sqlserver_to_postgres.py"]
CMD ["--help"]
