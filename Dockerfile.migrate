# One-off data migration image: SQL Server -> PostgreSQL
# Keep this separate from the prod app image to avoid bloating
# production with ODBC drivers.
#
# Usage (see docker-compose.migrate.yml and deploy/migrate.sh):
#   docker compose -f docker-compose.migrate.yml build migrator
#   docker compose -f docker-compose.migrate.yml run --rm migrator --plan

FROM python:3.12-slim-bookworm

WORKDIR /app

# IR firewall blocks deb.debian.org — switch to Arvan mirror before any apt-get
RUN sed -i 's|http://deb.debian.org|https://mirror.arvancloud.ir/debian|g' /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|https://deb.debian.org|https://mirror.arvancloud.ir/debian|g' /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|deb.debian.org|mirror.arvancloud.ir/debian|g' /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources 2>/dev/null || true

# System deps:
#  - gcc/g++ + unixodbc-dev for building pyodbc
#  - libpq-dev for psycopg2
#  - curl + gnupg for Microsoft apt repo
#  - msodbcsql17: ODBC Driver 17 for SQL Server (matches MIG_SRC_DRIVER default)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev unixodbc-dev curl gnupg ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql17 \
    && apt-get purge -y curl gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Reuse prod requirements + add only migration extras (keeps prod requirements.txt lean)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "pyodbc==5.1.0"

# Copy project (needed for app/models for alembic + migrate script itself)
COPY . .

# Default: show help. Override with --plan, --tables, --set-admin-pass, etc.
ENTRYPOINT ["python", "migrate_sqlserver_to_postgres.py"]
CMD ["--help"]
