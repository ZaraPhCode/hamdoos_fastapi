# Database
DATABASE_URL=postgresql+asyncpg://ashauser:ashapass@db:5432/ashadb
POSTGRES_USER=ashauser
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=ashadb

# App
APP_NAME=Asha Shop
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ZarinPal Payment
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SITE_URL=https://your-domain.com
ZARINPAL_CALLBACK_URL=/api/v1/payment/callback/

# SMS Provider (FarazSMS or Melipayamak)
SMS_PROVIDER=Melipayamak

# FarazSMS
FARAZSMS_ENDPOINT=http://188.0.240.110/api/select
FARAZSMS_USERNAME=your-username
FARAZSMS_PASSWORD=your-password
FARAZSMS_FROM_NUMBER=+983000505

# Melipayamak
MELIPAYAMAK_ENDPOINT=https://rest.payamak-panel.com/api/SendSMS/
MELIPAYAMAK_USERNAME=your-username
MELIPAYAMAK_PASSWORD=your-password
MELIPAYAMAK_FROM_NUMBER=50004001107430

# Bale SMS
BALE_ENDPOINT=https://safir.bale.ai
BALE_ACCESS_KEY=your-access-key
BALE_BOT_ID=0

# Email (Outlook SMTP)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@outlook.com
EMAIL_PASSWORD=your-password
EMAIL_FROM=your-email@outlook.com

# DB Backup (db_backup service) — see deploy/backup/backup_to_s3.sh
# Where to put the dumps. For Backblaze B2 set S3_ENDPOINT_URL; plain AWS S3
# leaves it empty.
S3_BUCKET=asha-ai-db-backup
S3_ENDPOINT_URL=
S3_REGION=us-east-1
# These can be named AWS_* or Backblaze style; either works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#BACKBLAZE_ACCESS_KEY=
#BACKBLAZE_SECRET_KEY=
#BACKBLAZE_ENDPOINT_URL=

# SQL Server source (one-off migration only — READ-ONLY, never modified)
# The migrator script REQUIRES these. Prefer a login with only SELECT/db_datareader.
MIG_SRC_DRIVER=FreeTDS
MIG_SRC_HOST=your-sqlserver-host-or-ip,1433
MIG_SRC_DATABASE=your_source_db
MIG_SRC_USER=your_readonly_user
MIG_SRC_PASSWORD=your_readonly_password
MIG_SRC_SCHEMA=dbo